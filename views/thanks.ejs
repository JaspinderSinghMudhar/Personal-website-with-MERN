<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/js-pages/new-style.css">
  <title>Thank You | Jaspinder Singh</title>
  <style>
    :root {
      --bg-rgb: 32, 32, 48;
      --color-rgb: 239, 241, 197;
      --color-hex: #eff1c5;
    }

    .thanks-content {
      display: flex;
      flex: 1;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      color: #fff;
    }

    .thanks-content h1 {
      margin: 0 0 16px;
      color: var(--color-hex);
      font-size: clamp(36px, 7vw, 64px);
    }

    .thanks-content h1 {
      margin: 0 0 16px;
      color: var(--color-hex);
      font-size: clamp(26px, 7vw, 36px);
    }

    .thanks-content p {
      margin: 0;
      font-size: clamp(16px, 2.5vw, 22px);
    }
  </style>
</head>

<body>
  	<%- include('elements/menu-color-nav') %>
  <section class="main-section">
			<%- include('elements/top-data') %>

    <section>
      <main class="thanks-content">
        <h1>Thank you!</h1>
        <% if (UserName) {%>
        <p>
          <b><%= UserName %>,</b> Your message has been received.
        </p>
        <% } %>
      </main>
    </section>
			<%- include('elements/bottom-data') %>
  </section>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/Detect.js/2.2.2/detect.min.js"></script>
  <script src="/js-pages/function.js"></script>
  <script src="/js-pages/api-function.js"></script>
</body>

</html>