<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/js-pages/new-style.css">
    <title>Projects | Jaspinder Singh</title>
    <style>
        /* Projects */
        .project.main-container {
            color: #fff;
            text-align: center;
        }

        .project.main-container .h1 {
            font-size: 42px;
            font-weight: 700;
            text-align: center;
            margin: 20px auto 10px auto;
            /* margin-bottom: 40px;
			*/
        }

        .project.main-container .projects_display {
            overflow-y: scroll;
            max-height: calc(100% - 120px);
            max-width: 1200px;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            margin: auto;
            margin-top: 20px;
        }

        .project.main-container .projects_display .project_scroll {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
            -webkit-box-pack: center;
            -ms-flex-pack: center;
            justify-content: center;
            -ms-flex-wrap: wrap;
            flex-wrap: wrap;
        }

        .project.main-container .projects_display .project_scroll .pro-card {
            margin: 0px 20px;
            width: 30%;

        }

        @supports (-moz-appearance:none) {
            .project.main-container .projects_display .project_scroll .pro-card {
                width: 40%;
            }
        }

        .project.main-container .projects_display .project_scroll .pro-card img {
            /* height: 350px; */
            margin: auto;
        }

        .project.main-container .projects_display .project_scroll .pro-card:nth-child(2n) {
            margin-top: 100px;
        }

        @media (max-width: 1280px) {

            .project.main-container .h1 {
                font-size: 32px;
                margin: 20px auto 20px auto;
            }

            .project.main-container .projects_display .project_scroll .pro-card {
                width: 50%;
                display: -webkit-box;
                display: -ms-flexbox;
                display: flex;
            }

            .project.main-container .projects_display .project_scroll .pro-card:nth-child(2n) {
                margin-top: 30px;
            }

            .project.main-container .projects_display {
                max-height: calc(100% - 120px);
            }
        }

        @media (max-width:1137px) {
            .project.main-container .projects_display .project_scroll .pro-card {
                margin-top: 30px;
            }

            .project.main-container .h1 {
                font-size: 30px;
                margin: 10px auto 20px auto;
            }
        }

        @media (max-width:880px) {
            .project.main-container .projects_display .project_scroll .pro-card img {
                height: 350px;
                margin: auto;
            }
        }

        @media (max-width:768px) {
            .project.main-container .projects_display .project_scroll .pro-card img {
                height: auto;
                margin: auto;
                width: -webkit-fill-available;
            }

            @supports (-moz-appearance:none) {
                .project.main-container .projects_display .project_scroll .pro-card img {
                    width: 100%
                }
            }
        }

        @media (max-width: 490px) {
            .project.main-container .projects_display .project_scroll {
                display: -webkit-box;
                display: -ms-flexbox;
                display: flex;
                -ms-flex-pack: distribute;
                justify-content: space-around;
                -ms-flex-wrap: wrap;
                flex-wrap: wrap;
                -webkit-box-align: center;
                -ms-flex-align: center;
                align-items: center;
            }

            .project.main-container .projects_display .project_scroll .pro-card {
                width: 45%;
                margin: 0px;
            }

            @supports (-moz-appearance:none) {
                .project.main-container .projects_display .project_scroll .pro-card {
                    width: 90%;
                }

                .project.main-container .projects_display .project_scroll .pro-card {
                    margin: 20px;
                }
            }
        }

        .pro-card {
            -webkit-animation: 1s linear both showprocard;
            animation: 1s linear both showprocard;
            animation-timeline: view();
            animation-range: cover contain 0px;
        }

        @-webkit-keyframes showprocard {
            from {
                -webkit-transform: rotateY(45deg) scale(0.6);
                transform: rotateY(45deg) scale(0.6);
                opacity: 0.5;
            }

            to {
                -webkit-transform: rotateY(0deg) scale(1);
                transform: rotateY(0deg) scale(1);
                opacity: 1;
            }
        }

        @keyframes showprocard {
            from {
                -webkit-transform: rotateY(45deg) scale(0.6);
                transform: rotateY(45deg) scale(0.6);
                opacity: 0.5;
            }

            to {
                -webkit-transform: rotateY(0deg) scale(1);
                transform: rotateY(0deg) scale(1);
                opacity: 1;
            }
        }
    </style>
</head>

<body>
    <div class="colorization">
        <div class="color-1" onclick="colorization(0)"></div>
        <div class="color-2" onclick="colorization(1)"></div>
        <div class="color-3" onclick="colorization(2)"></div>
        <div class="color-4" onclick="colorization(3)"></div>
    </div>
    <div class="mouse_follower"></div>
    <div class="main-menu" id="nav-pop">
        <a href="/" class="home_ ">Home</a>
        <a href="/projects" class="projects_ active">Projects</a>
        <a href="/about" class="about_">About</a>
        <a href="/contact" class="contact_">Contact</a>
        <div class="colorization">
            <div class="color-1" onclick="colorization(0)"></div>
            <div class="color-2" onclick="colorization(1)"></div>
            <div class="color-3" onclick="colorization(2)"></div>
            <div class="color-4" onclick="colorization(3)"></div>
        </div>
    </div>
    <a href="#0" class="close-nav"></a>
    <a href="#nav-pop">
        <svg class="mob-nav" width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
            <rect width="60" height="60" rx="30" fill="#444444" fill-opacity="0.5" />
            <path d="M17 20H44" stroke="#EFF1C5" stroke-width="2" stroke-linecap="round" />
            <path d="M17 30H44" stroke="#EFF1C5" stroke-width="2" stroke-linecap="round" />
            <path d="M17 40H44" stroke="#EFF1C5" stroke-width="2" stroke-linecap="round" />
        </svg>
    </a>

    <section class="main-section">
        <div class="top-data">
            <div class="long-late">
                <span class="long-data">Longitude <span class="sap">~</span><span class="data"></span></span>
                <span class="late-data">Latetude <span class="sap">~</span><span class="data"></span></span>
            </div>
            <div class="brow-os">
                <span class=" brow-data"><span class="data"></span><span class="sap">~</span> Browser</span>
                <span class="os-data"><span class="data"></span><span class="sap">~</span> OS</span>
            </div>
        </div>
        <div class="project main-container">
            <h1 class="h1">
                Project Showcase
            </h1>
            <div class="projects_display">
                <div class="project_scroll">
                     <% for (let project of projects ){%>
                    <a href="<%= project['slug'] %>" class="pro-card">
                        <img src=" <%= project['image'] %>" alt="">
                    </a>
                    <% }%>
                </div>

            </div>
        </div>
        <div class="bottom-data">
            <div class="location-ip">
                <span class="location-data"><span class="data"></span><span class="sap">~</span> Location</span>
                <span class="ip-data"><span class="data"></span><span class="sap">~</span> IP</span>
            </div>
            <div class="time-spend">
                <span class="spend-data">Country <span class="sap">~</span><span class="data">a</span></span>
                <span class="time-data">Local Time <span class="sap">~</span><span class="data"></span></span>
            </div>
        </div>
    </section>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Detect.js/2.2.2/detect.min.js"></script>
    <script src="/js-pages/function.js"></script>
    <script src="/js-pages/api-function.js"></script>
</body>

</html>