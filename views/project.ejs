<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/js-pages/new-style.css">
    <title>Projects | Jaspinder Singh</title>
<style>
	/* Project Single */
	.project-single.main-container {
		overflow-y: scroll;
		max-width: 1200px;
		margin: auto;
		display: flex;
		height: inherit;
		margin: auto 100px;
		justify-content:center;
	}
	.project-single-scroll{
		display: flex;
		justify-content: center;
		flex-wrap: wrap;
	}
	.project-single .info-row{
		display: flex;
		justify-content: center;
		align-items: flex-start;
		gap: 20px;
	}
	.project-single .info .data h2{
		margin-bottom:10px;
	}
	.project-single .info .data p{
		max-width: 600px;
		color: var(--color-hex);
		font-size: 18px;
		font-weight: 400;
		line-height: 28px;
		letter-spacing: 1.5px;
		margin-bottom:10px;
	}
	.project-single .info .data a{
		text-decoration: none;
		color: #fff;
		border-bottom: 2px solid #fff;
		padding-bottom: 5px;
		display: flex;
		flex-direction: row;
		gap: 10px;
		width: fit-content;
		font-size: 18px;
		font-weight: 600;
		align-items: center;
		align-content: center;
	}		
	.project-single .tech h4{
		margin:30px 0px 10px 0px;
	}
	.project-single .tech-use{
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: flex-start;
		gap: 10px;
	}

	.project-single .tech-use h3{
		font-size: 16px;
		color: var(--color-hex);
		font-weight: 400;
		border: 1px solid var(--color-hex);
		padding: 10px 20px;
		border-radius: 10px;
		margin:0px;
	}
	@media (max-width:1137px) {
		.project-single.main-container .info-row {
			flex-direction: column;
			align-items: center;
		}
		.project-single .img-body img{
			width:100%;
		}
	}
	@media (max-width:880px) {
		.project-single.main-container {
			margin: auto 10px;
		}
		.project-single .info .data p, .project-single .info .data a{
			font-size:16px;
			line-height: 24px;
			letter-spacing: 1.2px;
		}
	}
	@media (max-width: 585px) {
		.project-single .tech-use h3 {
			font-size: 16px;
			color: var(--color-hex);
			font-weight: 400;
			border: 1px solid var(--color-hex);
			padding: 5px 10px;
			border-radius: 10px;
		}
	}
	@media	(max-width:450px){
		.project-single .info-row {
			gap: 0px;
		}
		.img-body{
			max-width:300px;
		}
		.project-single .info .data p, .project-single .info .data a {
			font-size: 12px;
			line-height: 18px;
			letter-spacing: 1.2px;
		}
	}

</style>
</head>
<body>
	<div class="colorization">
		<div class="color-1" onclick="colorization(0)"></div>
		<div class="color-2" onclick="colorization(1)"></div>
		<div class="color-3" onclick="colorization(2)"></div>
		<div class="color-4" onclick="colorization(3)"></div>
	</div>
	<div class="mouse_follower"></div>
	<div class="main-menu" id="nav-pop">
		<a href="/" class="home_">Home</a>
		<a href="/projects" class="projects_">Projects</a>
		<a href="/about" class="about_">About</a>
		<a href="/contact" class="contact_">Contact</a>
		<div class="colorization">
			<div class="color-1" onclick="colorization(0)"></div>
			<div class="color-2" onclick="colorization(1)"></div>
			<div class="color-3" onclick="colorization(2)"></div>
			<div class="color-4" onclick="colorization(3)"></div>
		</div>
	</div>
	<a href="#0" class="close-nav"></a>
	<a href="#nav-pop">
		<svg class="mob-nav" width="60" height="60" viewBox="0 0 60 60" fill="none" xmlns="http://www.w3.org/2000/svg">
			<rect width="60" height="60" rx="30" fill="#444444" fill-opacity="0.5"/>
			<path d="M17 20H44" stroke="#EFF1C5" stroke-width="2" stroke-linecap="round"/>
			<path d="M17 30H44" stroke="#EFF1C5" stroke-width="2" stroke-linecap="round"/>
			<path d="M17 40H44" stroke="#EFF1C5" stroke-width="2" stroke-linecap="round"/>
		</svg>
	</a>
	<section class="main-section">
		<div class="top-data">
			<div class="long-late">
				<span class="long-data">Longitude <span class="sap">~</span><span class="data"></span></span>
				<span class="late-data">Latetude <span class="sap">~</span><span class="data"></span></span>
			</div>
			<div class="brow-os">
				<span class=" brow-data"><span class="data"></span><span class="sap">~</span> Browser</span>
				<span class="os-data"><span class="data"></span><span class="sap">~</span> OS</span>
			</div>
		</div>
		<div class=" project-single main-container">
			<div class="project-single-scroll">
				<div class="info-row">
					<div class="img-body">
						<img src="<%= project.image %>" alt="">
					</div>
					<div class="info">
						<div class="data">
							<h2><%= project.title %></h2>
							<p><%= project.dis %></p>
							<a href="<%= project.project_url %>" target="_blank">View Project <svg width="17" height="16" viewBox="0 0 17 16" fill="none" xmlns="http://www.w3.org/2000/svg">
								<path d="M1 7C0.447715 7 0 7.44772 0 8C0 8.55228 0.447715 9 1 9V7ZM16.7071 8.70711C17.0976 8.31658 17.0976 7.68342 16.7071 7.29289L10.3431 0.928932C9.95262 0.538408 9.31946 0.538408 8.92893 0.928932C8.53841 1.31946 8.53841 1.95262 8.92893 2.34315L14.5858 8L8.92893 13.6569C8.53841 14.0474 8.53841 14.6805 8.92893 15.0711C9.31946 15.4616 9.95262 15.4616 10.3431 15.0711L16.7071 8.70711ZM1 9H16V7H1V9Z" fill="white"/>
								</svg>
							</a>
						</div>
						<div class="tech">
							<h4>Tech Use :</h4>
							<div class="tech-use">
                                <% if (project.tags_content_1){ %>
								<h3><%= project.tags_content_1 %></h3>
                                <%}%>
                                <% if (project.tags_content_2){ %>
								<h3><%= project.tags_content_2 %></h3>
                                <%}%>
                                <% if (project.tags_content_3){ %>
								<h3><%= project.tags_content_3 %></h3>
                                <%}%>
                                <% if (project.tags_content_4){ %>
								<h3><%= project.tags_content_4 %></h3>
                                <%}%>
                                <% if (project.tags_content_5){ %>
								<h3><%= project.tags_content_5 %></h3>
                                <%}%>
							</div>
						</div>

					</div>  
				</div>
			</div>
		</div>
		<div class="bottom-data">
			<div class="location-ip">
				<span class="location-data"><span class="data"></span><span class="sap">~</span> Location</span>
				<span class="ip-data"><span class="data"></span><span class="sap">~</span> IP</span>
			</div>
			<div class="time-spend">
				<span class="spend-data">Country <span class="sap">~</span><span class="data">a</span></span>
				<span class="time-data">Local Time <span class="sap">~</span><span class="data"></span></span>
			</div>
		</div>
	</section>
	<script src="https://cdnjs.cloudflare.com/ajax/libs/Detect.js/2.2.2/detect.min.js"></script>
	<script src="/js-pages/function.js"></script>
	<script src="/js-pages/api-function.js"></script>
</body>

</html>