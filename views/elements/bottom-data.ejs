<div class="bottom-data">
    <div class="location-ip">
        <span class="location-data"><span class="data">
                <%= geo.city %>
            </span><span class="sap">~</span> Location</span>
        <span class="ip-data"><span class="data">
                <%= ip %>
            </span><span class="sap">~</span> IP</span>
    </div>
    <div class="time-spend">
        <span class="spend-data">Country <span class="sap">~</span><span class="data">
                <%= geo.country %>
            </span></span>
        <span class="time-data">Local Time <span class="sap">~</span><span class="data"></span></span>
    </div>
</div>