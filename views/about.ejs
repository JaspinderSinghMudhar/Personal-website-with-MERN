<style>
	/* About */
	.about.main-container {
		display: flex;
		height: inherit;
	}

	.about.main-container .info-row {
		display: flex;
		gap: 40px;
		justify-content: center;
		margin: auto;
	}

	.about.main-container .info-row .info {
		width: 80%;
	}

	.about.main-container .info-row .info .h1 {
		font-size: 64px;
		font-weight: 700;
		text-align: center;
		margin: 20px auto 40px auto;
	}

	.about.main-container .info-row .info .para {
		color: var(--color-hex);
		font-size: 26px;
		font-weight: 400;
		line-height: 45px;
		letter-spacing: 2.6px;
		text-align: center;
	}

	.about.main-container .image {
		position: absolute;
		bottom: 0px;
		left: 50%;
		transform: translateX(-50%);
		width: 500px;
		z-index: -1;
		opacity: 0.4;
		filter: grayscale(1);
	}

	.other-info {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 20px;
	}

	.other-info svg:not(.js-resume svg) {
		width: 30px;
		height: 30px;
		color: #fff;
	}

	.js-resume {
		border: 1px solid #fff;
		padding: 5px 10px 5px 5px;
		border-radius: 10px;
		display: flex;
		align-items: center;
		gap: 5px;
		text-decoration: none;
		color: #fff;

		& svg {
			width: 25px;
			height: 25px;
		}
	}

	@media (max-width: 1280px) {
		.about.main-container .info-row .info .h1 {
			font-size: 44px;
			margin: 20px auto 20px auto;
		}

		.about.main-container .info-row .info .para {
			font-size: 20px;
			line-height: 38px;
		}
	}

	@media (max-width:1137px) {
		.about.main-container .info-row .info .para {
			font-size: 18px;
			line-height: 28px;
		}

		.about.main-container .info-row .info .h1 {
			font-size: 30px;
		}
	}

	@media (max-width: 585px) {
		.about.main-container .info-row .info .h1 {
			margin: 20px auto 10px auto;
		}

		.about.main-container .info-row .info .para {
			font-size: 16px;
			line-height: 24px;
		}
	}

	@media (max-width: 490px) {
		.about.main-container .info-row {
			width: -webkit-fill-available;
		}

		.about.main-container .info-row .info {
			width: 100%;
		}

		.about.main-container .info-row .info .para {
			font-size: 16px;
			line-height: 24px;
			letter-spacing: 1.5px;
		}

		.other-info {
			gap: 10px 20px;
			flex-wrap: wrap;
		}

	}
</style>

